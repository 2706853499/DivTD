{
  "env": [
    {
      "name": ["Asterix-MinAtar-v0"],
      "max_episode_steps": [-1],
      "input_type": ["pixel"]
    }
  ],
  "agent": [
    {
      "name": ["DQN"]
    }
  ],
  "train_steps": [3000],
  "test_per_episodes": [-1],
  "device": ["cpu"],
  "feature_dim": [128],
  "hidden_layers": [[]],
  "memory_type": ["FiniteReplay"],
  "memory_size": [1e4],
  "exploration_type": ["LinearEpsilonGreedy"],
  "exploration_steps": [100],
  "epsilon_steps": [1e3],
  "epsilon_start": [1.0],
  "epsilon_end": [0.1],
  "epsilon_decay": [0.999],
  "loss": ["SmoothL1Loss"],
  "optimizer": [
    {
      "name": ["RMSprop"],
      "kwargs": [{"lr": [3e-4], "alpha": [0.95], "centered": [true], "eps": [0.01]}]
    }
  ],
  "batch_size": [32],
  "display_interval": [100],
  "rolling_score_window": [{"Train": [10], "Test": [10]}],
  "discount": [0.99],
  "seed": [1],
  "show_tb": [false],
  "gradient_clip": [-1],
  "target_network_update_steps": [100],
  "network_update_steps": [1],
  "generate_random_seed": [false],
  "eval_freq": [500],
  "eval_episodes": [2],
  "eval_epsilon": [0.0]
}
